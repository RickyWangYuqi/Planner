{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planer",
  "version": "1.0.0",
  "identifier": "com.planer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Planer 日程便签",
        "width": 440,
        "height": 740,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "小而美的 Windows 桌面日程记录便签",
    "longDescription": "Planer 日程便签 — 本地优先、自动保存的日程记录工具，支持当日/未来日程、拖动排序、历史恢复、置顶与系统托盘。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
